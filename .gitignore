# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-dev/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (can opt-in for commiting if needed)
.env*

# segredos do backend PHP (credenciais SMTP) — nunca versionar
/src/php/config.php

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Arquivos temporários & dumps de tradução
translations-*.json
__deploy_ftp.txt

# IDE & editor
.vscode/settings.json
.idea/

# OS
Thumbs.db
.DS_Store

# Logs & temporários
*.log
*.tmp
